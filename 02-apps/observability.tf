# Grafana dashboard for vLLM, rag-api, TEI and GPU cost; the kube-prometheus-stack Grafana sidecar loads
# every ConfigMap labelled grafana_dashboard=1. Plain file(), not the k8s-manifests module: templatefile()
# would try to render Grafana's own ${...} variables. The JSON is generated by dashboards/gen_dashboard.py
resource "kubernetes_config_map_v1" "dashboard_llm_rag" {
  metadata {
    name      = "dashboard-llm-rag"
    namespace = local.platform.monitoring_namespace
    labels    = { grafana_dashboard = "1" }
  }

  data = {
    # the placeholder is a quoted string so the file stays valid JSON; replacing the quotes too leaves a number
    "llm-rag.json" = replace(
      file("${path.module}/dashboards/llm-rag.json"),
      "\"__KEDA_THRESHOLD__\"",
      tostring(var.vllm_autoscaling.queue_threshold)
    )
  }
}
