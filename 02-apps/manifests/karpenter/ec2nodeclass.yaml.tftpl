apiVersion: karpenter.k8s.aws/v1
kind: EC2NodeClass
metadata:
  name: default # shared by both NodePools
spec:
  role: ${node_role_name}
  amiSelectorTerms:
    - alias: ${node.ami_alias} # al2023@... resolves to the NVIDIA variant on GPU instances
  subnetSelectorTerms:
    - tags: { karpenter.sh/discovery: ${cluster_name} }
  securityGroupSelectorTerms:
    - tags: { karpenter.sh/discovery: ${cluster_name} }
  blockDeviceMappings:
    - deviceName: /dev/xvda
      ebs: { volumeSize: ${node.volume_size}, volumeType: gp3, encrypted: true, deleteOnTermination: true }
  tags: ${jsonencode(tags)} # 00-infra's tags; provider default_tags don't reach Karpenter's instances
