apiVersion: karpenter.sh/v1
kind: NodePool
metadata:
  name: cpu
spec:
  template:
    spec:
      nodeClassRef:
        group: karpenter.k8s.aws
        kind: EC2NodeClass
        name: default
      requirements:
        - key: kubernetes.io/arch
          operator: In
          values: ["amd64"]
        - key: karpenter.k8s.aws/instance-category
          operator: In
          values: ${jsonencode(cpu.instance_categories)} # keep GPU categories (g, p) out of the CPU pool
        - key: karpenter.sh/capacity-type
          operator: In
          values: ${jsonencode(cpu.capacity_types)}
  limits:
    cpu: "${cpu.cpu_limit}"
    memory: "${cpu.memory_limit}"
